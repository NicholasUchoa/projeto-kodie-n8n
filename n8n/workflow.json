{
  "name": "Classificador de Mensagens com IA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mensagem",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "classificador-mensagem"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n2-0",
              "name": "mensagem",
              "value": "={{ $json.body.mensagem }}",
              "type": "string"
            },
            {
              "id": "n2-1",
              "name": "remetente",
              "value": "={{ $json.body.remetente || 'não informado' }}",
              "type": "string"
            },
            {
              "id": "n2-2",
              "name": "canal",
              "value": "={{ $json.body.canal || 'webhook' }}",
              "type": "string"
            },
            {
              "id": "n2-3",
              "name": "recebido_em",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "n2",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/classificar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { mensagem: $json.mensagem, remetente: $json.remetente, canal: $json.canal } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n3",
      "name": "HTTP Request (API + IA)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-financeiro",
                    "leftValue": "={{ $json.setor }}",
                    "rightValue": "financeiro",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renamedOutput": true,
              "outputKey": "Financeiro"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-suporte_tecnico",
                    "leftValue": "={{ $json.setor }}",
                    "rightValue": "suporte_tecnico",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renamedOutput": true,
              "outputKey": "Suporte Técnico"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-comercial",
                    "leftValue": "={{ $json.setor }}",
                    "rightValue": "comercial",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renamedOutput": true,
              "outputKey": "Comercial"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Atendimento Geral"
        }
      },
